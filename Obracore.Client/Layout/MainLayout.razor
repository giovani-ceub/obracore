@using Obracore.Client.Shared
@inherits LayoutComponentBase

<div class="page">
    <Toasts />

    <header class="top-row px-4 d-flex justify-content-between align-items-center text-white small">
        <button class="btn btn-outline-light d-lg-none" @onclick="ToggleSidebar">
            <i class="bi @(SidebarVisible ? "bi-x-lg" : "bi-list")"></i>
        </button>

        <span>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
    </header>

    <div class="main-container">
        <div class="@SidebarClass d-lg-block" @onclick="HandleSidebarClick">
            <NavMenu OnNavigate="CloseSidebar" />
        </div>

        @if (SidebarVisible)
        {
            <div class="sidebar-overlay d-lg-none" @onclick="CloseSidebar"></div>
        }

        <main class="main-content flex-grow-1">
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@code {
    private bool SidebarVisible = false; // Estado para Mobile

    // A classe 'show' será usada apenas em mobile para abrir o menu
    private string SidebarClass => SidebarVisible ? "sidebar show" : "sidebar"; 

    private void ToggleSidebar() => SidebarVisible = !SidebarVisible;

    public void CloseSidebar()
    {
        SidebarVisible = false;
        StateHasChanged();
    }
    private void HandleSidebarClick()
    {
        // Não faz nada - apenas previne o fechamento ao clicar dentro do sidebar
    }
}