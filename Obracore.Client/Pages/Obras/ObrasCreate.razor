@page "/obras/create"
@inject NavigationManager Navigation
@inject HttpClient Http
@inject ToastService ToastService

<h3 class="mb-4">Nova Obra</h3>

<EditForm Model="@obra" OnValidSubmit="SalvarObra">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="nome" class="form-label">Nome</label>
        <InputText id="nome" class="form-control" @bind-Value="obra.Nome" />
    </div>

    <div class="mb-3">
        <label for="descricao" class="form-label">Descrição</label>
        <InputTextArea id="descricao" class="form-control" @bind-Value="obra.Descricao" />
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label for="dtInicio" class="form-label">Data Início</label>
            <InputDate id="dtInicio" class="form-control" @bind-Value="obra.DtInicio" />
        </div>
        <div class="col-md-4 mb-3">
            <label for="dtFimPrevista" class="form-label">Data Fim Prevista</label>
            <InputDate id="dtFimPrevista" class="form-control" @bind-Value="obra.DtFimPrevista" />
        </div>
        <div class="col-md-4 mb-3">
            <label for="statusObra" class="form-label">Status</label>
            <InputSelect id="statusObra" class="form-select" @bind-Value="obra.StatusObra">
                <option value="">Selecione...</option>
                <option value="A">Ativa</option>
                <option value="I">Inativa</option>
            </InputSelect>
        </div>
    </div>

    <div class="mb-3">
        <label for="foto" class="form-label">Foto da Obra</label>
        <InputFile id="foto" OnChange="HandleFileSelected" />
        @if (!string.IsNullOrEmpty(previewUrl))
        {
            <div class="mt-2">
                <img src="@previewUrl" alt="Preview" class="img-thumbnail" style="max-height: 200px;" />
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">💾 Salvar</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Voltar">↩️ Voltar</button>
</EditForm>

@code {
    private ObraModel obra = new();
    private IBrowserFile? arquivoFoto;
    private string? previewUrl;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        arquivoFoto = e.File;
        using var stream = arquivoFoto.OpenReadStream(10_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        previewUrl = $"data:{arquivoFoto.ContentType};base64,{base64}";
    }

    private async Task SalvarObra()
    {
        using var content = new MultipartFormDataContent();
        content.Add(new StringContent(obra.Nome ?? ""), "Nome");
        content.Add(new StringContent(obra.Descricao ?? ""), "Descricao");
        content.Add(new StringContent(obra.StatusObra ?? ""), "StatusObra");
        if (obra.DtInicio.HasValue)
            content.Add(new StringContent(obra.DtInicio.Value.ToString("o")), "DtInicio");
        if (obra.DtFimPrevista.HasValue)
            content.Add(new StringContent(obra.DtFimPrevista.Value.ToString("o")), "DtFimPrevista");

        if (arquivoFoto != null)
        {
            var stream = arquivoFoto.OpenReadStream(10_000_000);
            content.Add(new StreamContent(stream), "Foto", arquivoFoto.Name);
        }

        var response = await Http.PostAsync("api/obras", content);

        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess("Obra cadastrada com sucesso!");
            Navigation.NavigateTo("/obras");
        }
        else
        {
            ToastService.ShowError("Erro ao cadastrar obra!");
        }
    }

    private void Voltar() => Navigation.NavigateTo("/obras");
}
