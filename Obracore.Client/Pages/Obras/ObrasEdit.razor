@page "/obras/edit/{Id:int}"
@inject NavigationManager Navigation
@inject ObraService ObraService
@inject ToastService ToastService

<h3 class="mb-4">Editar Obra</h3>

@if (obra == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <EditForm Model="@obra" OnValidSubmit="SalvarObra">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <InputText id="nome" class="form-control" @bind-Value="obra.Nome" />
            <ValidationMessage For="@(() => obra.Nome)" />
        </div>

        <div class="mb-3">
            <label for="descricao" class="form-label">Descrição</label>
            <InputTextArea id="descricao" class="form-control" @bind-Value="obra.Descricao" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label for="dtInicio" class="form-label">Data Início</label>
                <InputDate id="dtInicio" class="form-control" @bind-Value="obra.DtInicio" />
            </div>

            <div class="col-md-4 mb-3">
                <label for="dtFimPrevista" class="form-label">Data Fim Prevista</label>
                <InputDate id="dtFimPrevista" class="form-control" @bind-Value="obra.DtFimPrevista" />
            </div>

            <div class="col-md-4 mb-3">
                <label for="statusObra" class="form-label">Status</label>
                <InputSelect id="statusObra" class="form-select" @bind-Value="obra.StatusObra">
                    <option value="">Selecione...</option>
                    <option value="A">Ativa</option>
                    <option value="I">Inativa</option>
                </InputSelect>
                <ValidationMessage For="@(() => obra.StatusObra)" />
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label">📸 Foto de Capa</label>

            <div class="d-flex flex-column align-items-start">
                @if (!string.IsNullOrEmpty(previewUrl))
                {
                    <!-- Preview da nova imagem -->
                    <img src="@previewUrl" alt="Nova imagem" class="img-thumbnail rounded shadow-sm mb-2" style="max-width: 300px;" />
                }
                else if (!string.IsNullOrEmpty(obra.FotoCapa))
                {
                    <!-- Imagem atual -->
                    <img src="@GetImagemUrl(obra.FotoCapa)" alt="Capa atual" class="img-thumbnail rounded shadow-sm mb-2" style="max-width: 300px;" />
                }
                else
                {
                    <!-- Placeholder -->
                    <div class="border rounded bg-light d-flex justify-content-center align-items-center mb-2"
                         style="width: 300px; height: 200px; color: #888;">
                        <span>Sem imagem</span>
                    </div>
                }

                <InputFile OnChange="HandleImageSelected" class="form-control" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">💾 Salvar Alterações</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Voltar">↩️ Voltar</button>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ObraModel? obra;
    private IBrowserFile? novaImagem;
    private string? previewUrl; // imagem temporária (base64) para preview

    protected override async Task OnInitializedAsync()
    {
        obra = await ObraService.GetObraAsync(Id);

        if (obra == null)
        {
            ToastService.ShowError("Obra não encontrada.");
            Navigation.NavigateTo("/obras");
        }
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        novaImagem = e.File;

        // Gera o preview corretamente e sem warning
        using var stream = novaImagem.OpenReadStream(maxAllowedSize: 10_000_000); // até 10MB
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);

        var base64 = Convert.ToBase64String(memoryStream.ToArray());
        previewUrl = $"data:{novaImagem.ContentType};base64,{base64}";
    }

    private async Task SalvarObra()
    {
        obra!.DtEdicao = DateTime.Now;

        bool sucesso;

        if (novaImagem != null)
        {
            sucesso = await ObraService.UpdateObraWithImageAsync(obra, novaImagem);
        }
        else
        {
            sucesso = await ObraService.UpdateObraAsync(obra);
        }

        if (sucesso)
        {
            ToastService.ShowSuccess("Obra atualizada com sucesso!");
            Navigation.NavigateTo("/obras");
        }
        else
        {
            ToastService.ShowError("Erro ao atualizar obra. Verifique os dados e tente novamente.");
        }
    }

    private string GetImagemUrl(string? fotoCapa)
    {
        if (string.IsNullOrEmpty(fotoCapa))
            return "/imagens/sem-img.png";

        if (fotoCapa.Contains("images/obras"))
            return $"https://localhost:7119/{fotoCapa}";

        return $"https://localhost:7119/images/obras/{fotoCapa}";
    }

    private void Voltar()
    {
        Navigation.NavigateTo("/obras");
    }
}
