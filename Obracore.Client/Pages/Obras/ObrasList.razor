@page "/obras"
@inject ObraService ObraService
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@inject IJSRuntime JS

<h3 class="mb-4 fw-semibold text-primary text-center">Obras Cadastradas</h3>

<div class="text-end mt-4 mb-4">
    <button class="btn btn-success px-4 shadow-sm" @onclick="NovaObra">
        <i class="bi bi-plus-circle me-1"></i> Nova Obra
    </button>
</div>

@if (obras == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
        <p class="mt-2 text-muted">Carregando obras...</p>
    </div>
}
else if (!obras.Any())
{
    <div class="alert alert-info text-center shadow-sm">
        Nenhuma obra encontrada.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var obra in obras)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <!-- Imagem no topo -->
                    <img src="@GetImagemUrl(obra.FotoCapa)" class="card-img-top rounded-top" alt="@obra.FotoCapa" onerror="this.onerror=null; this.src='/imagens/sem-img.png';" />

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0 text-primary fw-semibold">@obra.Nome</h5>
                            <span class="badge @(obra.StatusObra == "A" ? "bg-purple" : obra.StatusObra == "I" ? "bg-secondary" : "bg-info")">
                                @(obra.StatusObra == "A" ? "Ativa" : obra.StatusObra == "I" ? "Inativa" : "Finalizada")
                            </span>
                        </div>

                        <p class="card-text text-muted small flex-grow-1">
                            @obra.Descricao
                        </p>

                        <ul class="list-unstyled small mb-3">
                            <li><i class="bi bi-calendar-event me-1"></i> <strong>Início:</strong> @obra.DtInicio?.ToString("dd/MM/yyyy")</li>
                            <li><i class="bi bi-flag me-1"></i> <strong>Fim Previsto:</strong> @obra.DtFimPrevista?.ToString("dd/MM/yyyy")</li>
                        </ul>

                        <div class="d-flex justify-content-between mt-auto">
                            <!-- NOVO BOTÃO: VER ETAPAS -->
                            <button class="btn btn-sm btn-info text-white me-2" title="Ver Etapas" @onclick="() => VerEtapas(obra.Id)">
                                <i class="bi bi-list-task me-1"></i> Etapas
                            </button>
                            <!-- FIM NOVO BOTÃO -->

                            <div>
                                <button class="btn btn-sm btn-outline-primary me-2" title="Editar" @onclick="() => EditarObra(obra.Id)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" title="Excluir" @onclick="() => AbrirModalExcluir(obra.Id, obra.Nome)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal de Confirmação -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmDeleteLabel"><i class="bi bi-exclamation-triangle me-2"></i> Confirmar Exclusão</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p>Tem certeza que deseja excluir a obra <strong>@obraSelecionadaNome</strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusao">Excluir</button>
            </div>
        </div>
    </div>
</div>

@code {
    private string GetImagemUrl(string? fotoCapa)
    {
        if (string.IsNullOrEmpty(fotoCapa))
            return "/imagens/sem-img.png"; // imagem padrão local do client

        return $"https://localhost:7119/{fotoCapa}";
    }
}

@code {
    private List<ObraModel>? obras;
    private int obraSelecionadaId;
    private string? obraSelecionadaNome;

    protected override async Task OnInitializedAsync()
    {
        await CarregarObras();
    }

    private async Task CarregarObras()
    {
        obras = await ObraService.GetObrasDoUsuarioAsync();
    }

    private void NovaObra() => NavigationManager.NavigateTo("/obras/create");
    private void EditarObra(int id) => NavigationManager.NavigateTo($"/obras/edit/{id}");
    private void VerEtapas(int obraId) => NavigationManager.NavigateTo($"/obras/{obraId}/etapas");

    private async Task ExcluirObra(int id)
    {
        var sucesso = await ObraService.DeleteObraAsync(id);
        if (sucesso)
        {
            ToastService.ShowSuccess("Obra excluída com sucesso!");
            await CarregarObras();
        }
        else
        {
            ToastService.ShowError("Erro ao excluir a obra.");
        }
    }

    // Modal
    private async Task AbrirModalExcluir(int id, string nome)
    {
        obraSelecionadaId = id;
        obraSelecionadaNome = nome;
        await JS.InvokeVoidAsync("bootstrapInterop.showModal", "#confirmDeleteModal");
    }

    private async Task ConfirmarExclusao()
    {
        await ExcluirObra(obraSelecionadaId);
        await JS.InvokeVoidAsync("bootstrapInterop.hideModal", "#confirmDeleteModal");
    }
}
