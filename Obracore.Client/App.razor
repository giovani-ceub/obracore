@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Obracore.Client.Layout
@using Obracore.Client.Shared

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <p>Carregando informações do usuário...</p>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>

        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6 text-center">
                            <div class="card shadow border-0">
                                <div class="card-body py-5">
                                    <div class="text-warning mb-3">
                                        <i class="bi bi-search display-1"></i>
                                    </div>
                                    <h3 class="card-title text-dark mb-3">Página Não Encontrada</h3>
                                    <p class="card-text text-muted mb-4">
                                        Não foi possível encontrar a página solicitada.
                                    </p>
                                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                                        <a href="/" class="btn btn-primary me-md-2">
                                            <i class="bi bi-house me-1"></i>Ir para Home
                                        </a>
                                        <button class="btn btn-outline-dark" onclick="history.back()">
                                            <i class="bi bi-arrow-return-left me-1"></i>Voltar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
